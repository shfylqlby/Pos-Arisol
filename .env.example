# Salin file ini menjadi .env.local untuk pengembangan:
#   Copy-Item .env.example .env.local
# Lalu isi NEXT_PUBLIC_SUPABASE_ANON_KEY dari:
# Supabase Dashboard > Project Settings > API > Project API keys > anon/public
#
# Untuk Vercel: Settings > Environment Variables, isi dua variabel yang sama
# untuk Production, lalu Redeploy (nilai NEXT_PUBLIC_* dibaca saat build).

NEXT_PUBLIC_SUPABASE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_ANON_KEY=ISI_ANON_KEY_DI_SINI

# URL publik situs untuk sitemap, robots, dan metadata Open Graph.
# Ganti dengan domain produksi, mis. https://arisol.example.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Catatan:
# - Jangan pernah memakai service_role key di variabel NEXT_PUBLIC_*.
# - Client ID / Client Secret Google TIDAK ditaruh di sini.
#   Keduanya diisi di Supabase Dashboard > Authentication > Providers > Google.

# Notifikasi email pre-order (Supabase Edge Function, BUKAN env Next.js):
#   supabase functions deploy notify-preorder
#   supabase secrets set RESEND_API_KEY=... PREORDER_NOTIFY_EMAIL=email-pemilik@contoh.com
#   (opsional) \r
#   supabase secrets set ALLOWED_ORIGIN=https://domain-produksimu.com   (batasi CORS; disarankan)
